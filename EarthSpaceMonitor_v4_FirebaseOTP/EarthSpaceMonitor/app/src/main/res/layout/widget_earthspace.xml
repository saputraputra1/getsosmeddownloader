<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_tv_earthquake"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌍 Earthquake data"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_tv_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="☀️ Space Weather"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_tv_earth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔥 Earth Hotspots"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tv_update"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Updated"
            android:textColor="#AAAAAA"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate" />
    </LinearLayout>
</LinearLayout>
